@model IEnumerable<DTO.AreaDTO>
@{
    ViewBag.Title = "Area List";
}

<h2>@ViewBag.Title</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<a asp-action="AddArea" class="btn btn-success mb-3">Add New Area</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Area</th>
            <th>Area Short Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td>@i</td>
                    <td>@item.Area_Desc</td>
                    <td>@item.Area_ShortName</td>
                    <td>
                        <a asp-action="Test" asp-route-id="@item.Area_Code" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="DeleteTest" asp-route-id="@item.Area_Code" class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this test?');">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No tests found.</td>
            </tr>
        }
    </tbody>
</table>
